# Configuración local opcional de SonarQube. El build no necesita estos valores.
SONAR_HOST_URL=
SONAR_PROJECT_KEY=SourceTV-Support
SONAR_PROJECT_NAME=SourceTV-Support
SONAR_QUALITY_GATE_WAIT=true
SONAR_QUALITY_GATE_TIMEOUT=300

# Las rutas de compilación se pasan como variables de Make o del entorno.
# DEPS_DIR=
# BUILD_DIR=
# AMBUILD_DIR=.deps/exts-linux/ambuild
# VENV_DIR=
# SOURCEMOD_DIR=
# MMSOURCE_DIR=
# HL2SDK_DIR=
# DIST_DIR=
# STEAMWORKS_SDK_DIR=sdk_155

# Opcional. Recibo emitido por make test-coverage para el mismo build.
SONAR_COVERAGE_RECEIPT=
